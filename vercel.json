{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "[ -z \"$DIRECT_URL\" ] || prisma migrate deploy && next build",
  "crons": [
    {
      "path": "/api/sync/poll",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/sync/poll?backfill=weekly",
      "schedule": "0 10 * * 0"
    }
  ]
}
